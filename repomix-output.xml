) -> None:
    response = client.delete(
        f'/users/{user.id + 1}',
        headers={
            'Authorization': f'Bearer {token}',
        },
    )
    assert response.status_code == HTTPStatus.FORBIDDEN


def test_create_user_username_integrity_error(
